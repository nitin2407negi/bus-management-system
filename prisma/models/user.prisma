model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  phone        String?
  role         Role     @default(owner)
  company_name String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  drivers  Driver[]
  routes  Route[]
  conductors Conductor[]
  buses      Bus[]
}
enum Role {
  owner
  admin
  conductor
  driver
}